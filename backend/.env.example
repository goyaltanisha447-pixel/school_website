# Server Configuration
PORT=5000

# Database Configuration (Prisma)
# Uses SQLite locally out of the box (file:./dev.db)
DATABASE_URL="file:./dev.db"

# JWT Secrets
JWT_ACCESS_SECRET=dtc-access-secret-key-12345
JWT_REFRESH_SECRET=dtc-refresh-secret-key-67890

# Razorpay Test Credentials
# Get these by signing up at razorpay.com and switching to Test Mode.
# Expose key_id to the frontend, key_secret stays on the backend.
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere
